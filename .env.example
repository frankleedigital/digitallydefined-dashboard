# DigitallyDefined Dashboard - Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local

# Supabase project URL (no trailing slash)
VITE_SUPABASE_URL=https://dijjlppdljpcgyoakdnq.supabase.co

# Supabase anonymous key (safe for frontend)
VITE_SUPABASE_ANON_KEY=

# Shared API key sent as x-api-key to the dashboard backend.
# MUST match DASHBOARD_API_KEY in the os-backend secrets.
VITE_DASHBOARD_API_KEY=

# Assistant model override passed to the dashboard backend.
# "auto" lets OmniRoute pick the best available model.
VITE_DASHBOARD_ASSISTANT_MODEL=auto

# --- Integration values visible to the browser/client (VITE_* only) ---
# Keep real secrets in a local .env file or the server environment, not in committed source.
VITE_SHEETS_WEBHOOK_URL=
VITE_FACEBOOK_GROUP_ID=
VITE_FACEBOOK_ACCESS_TOKEN=
VITE_INSTAGRAM_BUSINESS_ID=
VITE_INSTAGRAM_ACCESS_TOKEN=
VITE_BREVO_API_KEY=
VITE_BREVO_LIST_ID=2
VITE_EMAIL_PROVIDER=brevo

# --- Optional integrations (feature-flagged) ---
# VITE_GA_INTEGRATION_ENABLED=false
# VITE_GA_MEASUREMENT_ID=
# VITE_GA_PROPERTY_ID=
# VITE_SOCIAL_INTEGRATION_ENABLED=false
# VITE_FACEBOOK_PAGE_ID=
# VITE_INSTAGRAM_BUSINESS_ID=
# VITE_YOUTUBE_CHANNEL_ID=
# VITE_LINKEDIN_ORG_ID=
# VITE_EMAIL_INTEGRATION_ENABLED=false
# VITE_EMAIL_PROVIDER=brevo
# VITE_COMMUNITY_INTEGRATION_ENABLED=false
# VITE_COMMUNITY_PLATFORM=facebook

# --- Notion (optional) — powers the NOTION dashboard tab ---
# To enable, create a Notion integration (https://www.notion.so/my-integrations),
# share each database with it, and paste the database IDs below.
# VITE_NOTION_API_KEY=secret_xxx
# VITE_NOTION_IDEAS_DB_ID=
# VITE_NOTION_CONTENT_DB_ID=
# VITE_NOTION_AUTOMATIONS_DB_ID=
# VITE_NOTION_PUBLISHING_QUEUE_DB_ID=
# VITE_NOTION_CONTENT_APPROVALS_DB_ID=
# VITE_NOTION_BUYER_SIGNALS_DB_ID=
# VITE_NOTION_AI_CONTENT_DRAFTS_DB_ID=